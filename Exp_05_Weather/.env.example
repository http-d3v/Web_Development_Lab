# Weather Application Environment Configuration
# Note: For static client-side deployment, the application utilizes the Open-Meteo
# open meteorological API by default (no API key required).
# If integrating with OpenWeatherMap or private weather proxies, configure below:

VITE_WEATHER_API_PROVIDER=open-meteo
VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
# VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
